*~
*.swp
*.swo
.fuse_hidden*
.directory
.Trash-*
.nfs*
.gvfs-fuse-daemon-*

# IDE and editors
.idea/
*.sublime-*
.history/
.windsurfrules
*.code-workspace
.vscode/sessions.json

# Temporary files
.temp/
temp/
tmp/
.build-tmp/
*.tmp
*.temp
*.log
*.cache
.cache/

# Environment files
.env*
!.env.example*
venv/
.venv/

# Dependencies
node_modules/
package-lock.json
pnpm-lock.yaml
.pnpm-store/

# Build outputs
dist/
es/
lib/
.next/
logs/
test-output/
*.tsbuildinfo
next-env.d.ts

# Framework specific
# Umi
.umi/
.umi-production/
.umi-test/
.dumi/tmp*/

# Vercel
.vercel/

# Testing and CI
coverage/
.coverage/
.nyc_output/
.eslintcache
.stylelintcache

# Service Worker
# Serwist
public/sw*
public/swe-worker*

# Generated files
public/*.js
public/sitemap.xml
public/sitemap-index.xml
sitemap*.xml
robots.txt

# Git hooks
.husky/prepare-commit-msg

# Documents and media
*.patch
*.pdf

# Cloud service keys
vertex-ai-key.json

# AI coding tools
.local/
.claude/
.mcp.json

CLAUDE.local.md

# MCP tools
.serena/**

# Misc
./packages/lobe-ui
*.ppt*
*.doc*
*.xls*

prd
GEMINI.md


# Next.js 15 dev cache
.next-dev-*/

# Local analysis / scratch artifacts
# If you wish to version any of these, remove the corresponding line.
tmp_*.json
performance-*.json
performance-monitoring-setup.js
Build Logs on Vercel*.csv
docs/logs_result.json
vietnam-market-testing-config.json

